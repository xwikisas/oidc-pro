    <property>
      <content>{{velocity}}
#if (!$xcontext.userReference &amp;&amp; $services.oidcpro.isOIDCAuthServiceEnabled())
  #set ($oidcProviders = $services.oidcpro.configurations)
  #if ($oidcProviders.size() &gt; 0)
    ## Load the resources from the WebJar because guests can't load skin extensions when the wiki requires authentication.
    #set ($oidcProWebJar = 'com.xwiki.oidcpro:oidc-pro-api')
    #set ($discard = $xwiki.linkx.use($services.webjars.url($oidcProWebJar, 'login.css'), {'type': 'text/css', 'rel': 'stylesheet'}))
    #set ($oidcCookieName = $services.oidcpro.clientConfigurationCookie)
    #set ($loginURL = $xwiki.getURL('XWiki.XWikiLogin', 'login', $escapetool.url({
      'xredirect': $xwiki.relativeRequestURL,
      'loginLink': 1
    })))
    {{html clean="false"}}
    &lt;script src="$escapetool.xml($services.webjars.url($oidcProWebJar, 'login.js'))" defer&gt;&lt;/script&gt;
    &lt;li class="dropdown oidcpro-login-menu"&gt;
      &lt;a class="btn btn-link dropdown-toggle" href="#" role="button" id="oidcpro-login-menu-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"&gt;
        $escapetool.xml($services.localization.render('oidcpro.login.title'))
        &lt;span class="caret"&gt;&lt;/span&gt;
      &lt;/a&gt;
      &lt;ul class="dropdown-menu dropdown-menu-right" aria-labelledby="oidcpro-login-menu-toggle"&gt;
        #foreach ($cfg in $oidcProviders)
          #set ($cfgName = $cfg.clientConfiguration.configurationName)
          &lt;li class="oidcpro-login-option"&gt;
            &lt;a href="$escapetool.xml($loginURL)" rel="nofollow" data-oidcpro-cookie="$escapetool.xml($oidcCookieName)" data-oidcpro-client="$escapetool.xml($cfgName)"&gt;
              #if ("$!cfg.iconName" != '')
                &lt;span class="oidcpro-login-icon" aria-hidden="true"&gt;$services.icon.renderHTML($cfg.iconName)&lt;/span&gt;
              #elseif ("$!cfg.iconURL" != '')
                &lt;span class="oidcpro-login-icon" aria-hidden="true"&gt;&lt;img src="$escapetool.xml($cfg.iconURL)" alt="" /&gt;&lt;/span&gt;
              #end
              &lt;span class="oidcpro-login-label"&gt;$escapetool.xml($cfgName)&lt;/span&gt;
            &lt;/a&gt;
          &lt;/li&gt;
        #end
      &lt;/ul&gt;
    &lt;/li&gt;
    {{/html}}
  #end
#end
{{/velocity}}</content>
