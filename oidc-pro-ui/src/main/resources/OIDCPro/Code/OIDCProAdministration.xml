    <property>
      <code>require(['jquery', 'xwiki-meta'], function ($, xm) {
  $('.oidcpro-config-create').on('click', function (e) {
    e.preventDefault();
    let newConfigurationRef = XWiki.Model.resolve('OIDCPro.Configurations.Configuration' + Date.now(), XWiki.EntityType.DOCUMENT, XWiki.currentDocument.getDocumentReference());
    let newConfigurationDoc = new XWiki.Document(newConfigurationRef);
    let createURL = newConfigurationDoc.getURL('edit', $.param({
      template: 'OIDCPro.Code.OIDCProTemplate',
      oidcTemplate: $(this).data('templateid') || 'default',
      form_token: xm.form_token
    }));
    console.log(createURL);
    window.open(createURL, '_blank');
  });
  $(document).on('change', '.oidcpro-switch input', function (e) {
    let elem = $(this);
    let checked = elem[0].checked;
    elem.attr('disabled', 1);
    let oidcConfigSerializedDocRef = elem.closest('.oidcpro-switch').data('docref');
    if (!oidcConfigSerializedDocRef) return;
    let oidcConfigDocRef = XWiki.Model.resolve(oidcConfigSerializedDocRef, XWiki.EntityType.DOCUMENT, XWiki.currentDocument.getDocumentReference());
    let oidcConfigDoc = new XWiki.Document(oidcConfigDocRef);
    let restURL = oidcConfigDoc.getRestURL('objects/XWiki.OIDC.ClientConfigurationClass/0/properties/skipped');
    var notification = new XWiki.widgets.Notification("$escapetool.javascript($services.localization.render('oidcpro.admin.enable.progress'))", 'inprogress')
    $.ajax(restURL, {
      method: 'PUT',
      contentType: 'text/plain',
      data: checked ? '0' : '1'
    }).then(data =&gt; {
      notification.hide();
      new XWiki.widgets.Notification("$escapetool.javascript($services.localization.render('oidcpro.admin.enable.done'))", 'done');
      elem.attr('disabled', null);
    }).catch(() =&gt; {
      notification.hide();
      elem[0].checked = !checked;
      elem.attr('disabled', null);
      new XWiki.widgets.Notification("$escapetool.javascript($services.localization.render('oidcpro.admin.enable.error'))", 'error');
    });
  });
});</code>
