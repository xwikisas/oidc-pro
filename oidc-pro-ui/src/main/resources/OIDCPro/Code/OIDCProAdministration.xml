    <property>
      <code>.oidcpro-admin-icon &gt; * {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}
.oidcpro-admin-icon {
  width: 20px;
  height: 20px;
  width: 20px;
  height: 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
}

/* The switch container */
.oidcpro-switch {
  position: relative;
  display: inline-block;
  width: 50px;
  height: 24px;
}

/* Hide checkbox */
.oidcpro-switch input {
  display: none;
}

/* Slider */
.oidcpro-slider {
  position: absolute;
  cursor: pointer;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: @btn-default-bg;
  transition: .4s;
  border-radius: 24px;
}

/* Handle */
.oidcpro-slider:before {
  position: absolute;
  content: "";
  height: 18px;
  width: 18px;
  left: 3px;
  bottom: 3px;
  background-color: @xwiki-border-color;
  border-radius: 50%;
  transition: .4s;
}

/* Checked state */
.oidcpro-switch input:checked + .oidcpro-slider {
  background-color: @brand-success;
}

.oidcpro-switch input:checked + .oidcpro-slider:before {
  transform: translateX(26px);
}
</code>
