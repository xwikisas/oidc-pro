#if(!$srid)
  #set($srid = $request.srid)
#end
#if(!$srid)
  #set($srid = $request.get('oidc.srid'))
#end
## The client selected by the user is sent in a cookie, which the authenticator reads only when no client is stored in
## the session yet.
$services.oidcpro.resetClientConfigurationSelection()
#template("startpage.vm")
<div class="main layoutsubsection">
## Set as an HTML main for better DOM tree semantics to facilitate navigation with assistive technologies.
<main id="mainContentArea">
#set ($oidcProWebJar = 'com.xwiki.oidcpro:oidc-pro-api')
<link rel="stylesheet" href="$escapetool.xml($services.webjars.url($oidcProWebJar, 'login.css'))" />
<script src="$escapetool.xml($services.webjars.url($oidcProWebJar, 'login.js'))" defer></script>
#set ($oidcCookieName = $services.oidcpro.clientConfigurationCookie)
<div id="content">
  ## Submit the login request again, now that the client is selected. The saved request (srid) and the repeated
  ## parameters (e.g. xredirect) bring the user back where the authentication started.
  <form class="xform" method="get" action="$escapetool.xml($request.requestURI)">
  #xwikimessageboxstart($services.localization.render('login') '')
  #set ($oidcClients = $services.oidcpro.configurations)
  ## Repeat input parameters, except the saved request identifier which is added below.
  #set ($params = ['srid', 'oidc.srid'])
  #foreach ($entry in $request.parameterMap.entrySet())
    #if (!$params.contains($entry.key))
      #foreach ($value in $entry.value)
        <input type="hidden" name="$escapetool.xml($entry.key)" value="$escapetool.xml($value)"/>
      #end
    #end
  #end

  ## Remember the srid
  #if ($srid)
    <input type="hidden" name="oidc.srid" value="$escapetool.xml($srid)"/>
  #end
  #if ($oidcClients.size() <= 0)
    <dl>
        ## Ask the provider
        <dt>$escapetool.xml($services.localization.render('oidc.template.provider.provider'))</dt>
        <dd><input type="text" name="oidc.provider"/></dd>
    </dl>
    <input type="submit" class="button" value="$escapetool.xml($services.localization.render('oidc.template.provider.submit'))"/>
  #else
  <ul class="auth-methods">
    #foreach ($client in $oidcClients)
      <li>
        <button type="submit" class="auth-method btn btn-default"
          data-oidcpro-cookie="$escapetool.xml($oidcCookieName)"
          data-oidcpro-client="$escapetool.xml($client.clientConfiguration.configurationName)">
          ## Keep the icon markup on one line so that the span is :empty when there is no icon.
          <span class="auth-method-icon" aria-hidden="true">#if ("$!client.iconName" != '')$services.icon.renderHTML($client.iconName)#elseif ("$!client.iconURL" != '')<img src="$escapetool.xml($client.iconURL)" alt="" />#end</span>
          <span class="auth-method-label">$escapetool.xml($client.clientConfiguration.configurationName)</span>
        </button>
      </li>
    #end
    </ul>

  #end
    
  </form>

  <hr/>

  <form>
    <input type="hidden" name="oidc.skipped" value="true"/>
    #if ($srid)
      <input type="hidden" name="srid" value="$escapetool.xml($srid)"/>
    #end

    <input type="submit" class="button" value="$escapetool.xml($services.localization.render('oidc.template.provider.skip.submit'))"/>
  #xwikimessageboxend()
  
  </form>
</div>
#template("endpage.vm")